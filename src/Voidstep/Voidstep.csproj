<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Voidstep</AssemblyName>
    <RootNamespace>Voidstep</RootNamespace>
    <Version>1.2.1</Version>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <Nullable>disable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <BannerlordReferenceDir Condition="'$(BannerlordReferenceDir)' == ''">$(MSBuildThisFileDirectory)..\..\references\runtime</BannerlordReferenceDir>
    <UseRuntimeReferences Condition="Exists('$(BannerlordReferenceDir)\TaleWorlds.MountAndBlade.dll')">true</UseRuntimeReferences>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Voidstep.Core\Voidstep.Core.csproj" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Core" Version="1.3.15.110062" Condition="'$(UseRuntimeReferences)' != 'true'" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies.Native" Version="1.3.15.110062" PrivateAssets="All" Condition="'$(UseRuntimeReferences)' != 'true'" />
    <PackageReference Include="Bannerlord.MCM" Version="5.12.1" IncludeAssets="compile" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" IncludeAssets="compile" />
    <PackageReference Include="NETStandard.Library" Version="2.0.3" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseRuntimeReferences)' == 'true'">
    <Reference Include="TaleWorlds.Library" HintPath="$(BannerlordReferenceDir)\TaleWorlds.Library.dll" Private="false" />
    <Reference Include="TaleWorlds.Engine" HintPath="$(BannerlordReferenceDir)\TaleWorlds.Engine.dll" Private="false" />
    <Reference Include="TaleWorlds.InputSystem" HintPath="$(BannerlordReferenceDir)\TaleWorlds.InputSystem.dll" Private="false" />
    <Reference Include="TaleWorlds.MountAndBlade" HintPath="$(BannerlordReferenceDir)\TaleWorlds.MountAndBlade.dll" Private="false" />
    <Reference Include="TaleWorlds.CampaignSystem" HintPath="$(BannerlordReferenceDir)\TaleWorlds.CampaignSystem.dll" Private="false" />
  </ItemGroup>
</Project>
